---
import "../styles/global.css";
import { getTranslations } from "../utils/i18n";

interface Props {
	title?: string;
	description?: string;
}

const t = getTranslations(Astro.currentLocale);

const {
	title = t.seo.title,
	description = t.seo.description,
} = Astro.props;

const currentLang = Astro.currentLocale || "pt-br";
---

<!DOCTYPE html>
<html lang={currentLang} class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="font-body-md text-body-md overflow-x-hidden selection:bg-secondary-container selection:text-on-secondary-container antialiased">
		
		<slot />

		<script>
			// Header Scroll Effect
			const updateHeader = () => {
				const header = document.querySelector('header');
				if (header) {
					if (window.scrollY > 20) {
						header.classList.add('shadow-sm');
						header.classList.remove('bg-surface/90');
						header.classList.add('bg-white');
					} else {
						header.classList.remove('shadow-sm');
						header.classList.remove('bg-white');
						header.classList.add('bg-surface/90');
					}
				}
			};

			window.addEventListener('scroll', updateHeader);
			updateHeader(); // Run immediately on load

			// Intersection Observer for Reveal Animations (Runs directly since scripts are deferred by default in Astro)
			const observerOptions = {
				root: null,
				rootMargin: '0px',
				threshold: 0.12
			};

			const observer = new IntersectionObserver((entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						if (entry.target.hasAttribute('data-timeline')) {
							entry.target.classList.add('is-active');
						} else if (entry.target.classList.contains('reveal-element')) {
							entry.target.classList.add('is-visible');
						} else if (entry.target.classList.contains('fade-in-up')) {
							entry.target.classList.add('visible');
						}
						observer.unobserve(entry.target);
					}
				}
			}, observerOptions);

			document.querySelectorAll('.reveal-element, .fade-in-up, [data-timeline]').forEach((el) => {
				observer.observe(el);
			});

			document.querySelectorAll('[data-timeline]').forEach((timeline) => {
				window.setTimeout(() => {
					if (!timeline.classList.contains('is-active')) {
						timeline.classList.add('is-active');
					}
				}, 2500);
			});
		</script>
	</body>
</html>
