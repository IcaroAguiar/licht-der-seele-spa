---
interface Props {
	num: string;
	title: string;
	description: string;
	duration?: string;
	price?: string;
	badge?: string;
	delayClass?: string;
	bgGradClass?: string;
	desktopOnly?: boolean;
	mobileOnly?: boolean;
}

const {
	num,
	title,
	description,
	duration = "60 min",
	price = "CHF --",
	badge = "Terapia",
	delayClass = "",
	bgGradClass = "bg-primary-fixed/20",
	desktopOnly = false,
	mobileOnly = false,
} = Astro.props;
---

<!-- Desktop Layout -->
{!mobileOnly && (
  <div class={`hidden md:flex items-end reveal-element p-6 -mx-6 rounded-3xl hover:bg-surface-container-low transition-colors duration-300 cursor-pointer group ${delayClass}`}>
    <div class="flex-shrink-0 mr-6">
      <span class="font-headline-md text-outline-variant group-hover:text-primary group-hover:translate-x-2 transition-all duration-300 inline-block">{num}</span>
    </div>
    <div class="flex flex-col w-full">
      <div class="flex items-baseline w-full">
        <span class="font-headline-md text-headline-md text-primary font-light">{title}</span>
        <div class="dotted-connector"></div>
        <span class="aura-badge">{badge}</span>
      </div>
      <p class="text-on-surface-variant font-body-md mt-2">{description}</p>
    </div>
  </div>
)}

<!-- Mobile Layout -->
{!desktopOnly && (
  <div class={`md:hidden fade-in-up group border border-outline-variant/30 rounded-2xl p-5 hover:bg-surface-container-low hover:border-primary/20 transition-all cursor-pointer relative overflow-hidden ${delayClass}`}>
    <div class={`absolute right-0 top-0 w-32 h-32 ${bgGradClass} rounded-bl-full -mr-10 -mt-10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 blur-2xl pointer-events-none`}></div>
    <div class="flex justify-between items-center mb-3 relative z-10">
      <h4 class="font-headline-sm text-headline-sm text-primary text-xl">{title}</h4>
      <span class="material-symbols-outlined text-outline-variant group-hover:text-primary transition-colors" aria-hidden="true">arrow_forward</span>
    </div>
    <p class="font-body-md text-body-md text-on-surface-variant text-sm mb-4 relative z-10">{description}</p>
    <div class="flex gap-2 relative z-10">
      <span class="inline-block px-3 py-1 rounded-full bg-surface text-on-surface font-label-md text-[11px] border border-outline-variant/50">{duration}</span>
      <span class="inline-block px-3 py-1 rounded-full bg-surface text-on-surface font-label-md text-[11px] border border-outline-variant/50">{price}</span>
    </div>
  </div>
)}
