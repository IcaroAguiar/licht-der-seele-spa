---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	title: string;
	description: string;
	price?: string;
	image?: string | ImageMetadata;
	video?: string;
	badge?: string;
	badgeBg?: string;
	delayClass?: string;
	isPlaceholder?: boolean;
	desktopOnly?: boolean;
	mobileOnly?: boolean;
}

const {
	title,
	description,
	price,
	image,
	video,
	badge,
	badgeBg = "bg-tertiary-fixed/40",
	delayClass = "",
	isPlaceholder = false,
	desktopOnly = false,
	mobileOnly = false,
} = Astro.props;

const posterSrc =
	typeof image === "object" && image !== null && "src" in image ? image.src : undefined;
---

<!-- Desktop Layout -->
{!mobileOnly && (
  <div class={`hidden md:block group reveal-element cursor-pointer ${delayClass}`}>
    <div class="aspect-[1/1] rounded-2xl overflow-hidden mb-6 bg-surface-container-high border border-outline-variant/20 group-hover:shadow-lg transition-all duration-300">
      {isPlaceholder || !image ? (
        <div class="w-full h-full flex items-center justify-center bg-surface-container">
          <span class="material-symbols-outlined text-outline-variant text-5xl" aria-hidden="true">spa</span>
        </div>
      ) : (
        <div class="product-media relative w-full h-full">
          <Image alt={title} class={`img-outline w-full h-full object-cover transition-transform duration-500 ${video ? "product-media__still" : "group-hover:scale-105"}`} src={image} />
          {video && (
            <video
              class="product-media__video img-outline absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={posterSrc}
              aria-hidden="true"
            >
              <source src={video} type="video/mp4" />
            </video>
          )}
        </div>
      )}
    </div>
    <div class="flex justify-between items-start group-hover:-translate-y-1 transition-transform duration-300">
      <div>
        <h3 class="font-headline-sm text-headline-sm text-primary mb-1">{title}</h3>
        <p class="text-on-surface-variant font-body-md text-sm">{description}</p>
      </div>
      {price && <span class="font-body-md text-secondary ml-2 font-medium tabular-nums">{price}</span>}
    </div>
  </div>
)}

<!-- Mobile Layout -->
{!desktopOnly && (
  <div class={`md:hidden fade-in-up glass-card rounded-2xl p-4 flex gap-4 items-center group cursor-pointer hover:bg-surface-container transition-colors ${delayClass}`}>
    <div class="w-24 h-24 rounded-xl overflow-hidden shrink-0 bg-surface-container flex items-center justify-center">
      {isPlaceholder || !image ? (
        <span class="material-symbols-outlined text-outline-variant text-4xl" aria-hidden="true">spa</span>
      ) : (
        <div class="product-media relative w-full h-full">
          <Image alt={title} class={`img-outline w-full h-full object-cover transition-transform duration-500 ${video ? "product-media__still" : "group-hover:scale-105"}`} src={image} />
          {video && (
            <video
              class="product-media__video img-outline absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={posterSrc}
              aria-hidden="true"
            >
              <source src={video} type="video/mp4" />
            </video>
          )}
        </div>
      )}
    </div>
    <div class="flex-1">
      <div class="flex justify-between items-start mb-1">
        <h4 class="font-label-md text-label-md text-primary text-base">{title}</h4>
        {price && <span class="font-body-md text-body-md text-secondary tabular-nums">{price}</span>}
      </div>
      <p class="font-body-md text-body-md text-sm text-on-surface-variant mb-2 line-clamp-2">{description}</p>
      {badge && (
        <span class={`inline-block px-2 py-0.5 rounded-full ${badgeBg} text-on-secondary-container font-label-md text-[10px]`}>
          {badge}
        </span>
      )}
    </div>
  </div>
)}
