---
import { Image } from "astro:assets";
import banhosImage from "../assets/images/banhos.jpg";
import ebooksImage from "../assets/images/ebooks.jpg";
import founderImage from "../assets/images/founder.jpg";
// Import local images
import heroDesktopImage from "../assets/images/hero_desktop.jpg";
import heroMobileImage from "../assets/images/hero_mobile.jpg";
import kitsImage from "../assets/images/kits.jpg";
import sabonetesImage from "../assets/images/sabonetes.jpg";
import BottomNav from "../components/BottomNav.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ProductCard from "../components/ProductCard.astro";
import ServiceItem from "../components/ServiceItem.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- Navigation Header -->
  <Header />

  <main class="pt-16 md:pt-20 pb-20 md:pb-0">
    <!-- HERO SECTION -->
    <!-- Desktop Hero -->
    <section class="hidden md:block relative pt-32 pb-section-gap-lg px-gutter max-w-container-max mx-auto overflow-hidden">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="order-2 md:order-1">
          <span class="reveal-element font-label-md text-label-md text-secondary uppercase tracking-[0.2em] mb-6 block">Holismo Moderno</span>
          <h1 class="reveal-element delay-100 font-display-lg text-display-lg text-primary mb-8 max-w-md">
            Rituais para cuidar da sua energia
          </h1>
          <p class="reveal-element delay-200 font-body-lg text-body-lg text-on-surface-variant mb-12 max-w-sm">
            Apoio holístico e ferramentas tangíveis para integrar o autocuidado à sua rotina diária.
          </p>
          <div class="reveal-element delay-300 flex flex-col sm:flex-row gap-4">
            <a href="#agendamento" class="bg-primary text-on-primary px-10 py-5 rounded-full font-label-md text-label-md hover:bg-primary/90 active:scale-95 hover:shadow-lg transition-all duration-200 text-center">
              Agendar sessão
            </a>
            <a href="#produtos" class="border border-primary text-primary px-10 py-5 rounded-full font-label-md text-label-md hover:bg-surface-container-low active:scale-95 transition-all duration-200 text-center">
              Ver produtos
            </a>
          </div>
        </div>
        <div class="order-1 md:order-2 relative">
          <div class="float-anim aspect-[4/5] rounded-[40px] overflow-hidden bg-surface-container-low border border-outline-variant/30 reveal-element delay-200">
            <Image alt="Spa Ritual" class="w-full h-full object-cover grayscale-[0.2] hover:scale-105 transition-transform duration-700" src={heroDesktopImage} loading="eager" fetchpriority="high" />
          </div>
          <div class="absolute -bottom-10 -left-10 w-48 h-48 bg-secondary-container/20 rounded-full blur-3xl -z-10"></div>
        </div>
      </div>
    </section>

    <!-- Mobile Hero -->
    <section class="md:hidden min-h-[85vh] flex flex-col items-center justify-center px-margin-mobile pt-12 pb-8 text-center relative overflow-hidden">
      <div class="absolute inset-0 opacity-30 pointer-events-none bg-[radial-gradient(circle_at_center,var(--color-secondary-container)_0%,transparent_70%)]"></div>
      <div class="relative z-10 w-full max-w-sm mx-auto mb-8 float-animation">
        <Image alt="A serene spa environment with soft, warm lighting." class="w-full h-auto rounded-[40px] shadow-2xl object-cover aspect-[4/5]" src={heroMobileImage} loading="eager" fetchpriority="high" />
      </div>
      <div class="z-10 flex flex-col items-center gap-4">
        <span class="fade-in-up inline-block px-4 py-1 rounded-full bg-secondary-container/30 text-on-secondary-container font-label-md text-label-md tracking-widest uppercase text-xs">Zurique, CH</span>
        <h2 class="fade-in-up font-headline-lg-mobile text-headline-lg-mobile text-primary tracking-tight leading-tight" style="transition-delay: 0.1s;">Rituais para<br/>cuidar da<br/><span class="italic text-secondary">sua energia</span></h2>
        <p class="fade-in-up font-body-lg text-body-lg text-on-surface-variant max-w-md mx-auto mt-2" style="transition-delay: 0.2s;">Holismo luminoso para o seu bem-estar profundo.</p>
        <a href="#agendamento" class="fade-in-up mt-6 bg-primary text-surface font-label-md text-label-md px-8 py-4 rounded-full hover:bg-on-primary-fixed-variant transition-all duration-300 transform hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(40,17,35,0.15)] flex items-center gap-2" style="transition-delay: 0.3s;">
          <span>Agendar Ritual</span>
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_right_alt</span>
        </a>
      </div>
    </section>


    <!-- RITUAL PROMISE (Desktop Only) -->
    <section class="hidden md:block bg-surface-container-low py-section-gap-md px-gutter">
      <div class="max-w-3xl mx-auto text-center reveal-element">
        <h2 class="font-headline-md text-headline-md text-primary mb-6 italic font-light">
          "Acreditamos que a clareza mental e a paz espiritual não são destinos, mas rituais diários de intenção e presença."
        </h2>
        <div class="w-16 h-[1px] bg-outline mx-auto mt-12 opacity-30"></div>
      </div>
    </section>


    <!-- STORE / PRODUCTS SECTION -->
    <section id="produtos" class="py-section-gap-lg px-margin-mobile md:px-gutter max-w-container-max mx-auto">
      <div class="flex justify-between items-end mb-12 md:mb-16 reveal-element">
        <div>
          <span class="font-label-md text-label-md text-secondary uppercase tracking-[0.2em] mb-4 block">A Loja</span>
          <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary">Ferramentas de Intenção</h2>
        </div>
        <a class="nav-link-underline font-label-md text-label-md text-primary pb-1 transition-all hidden md:inline-block" href="#">Ver coleção completa</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 md:gap-8">
        <!-- Sabonetes (Desktop Only) -->
        <ProductCard 
          title="Sabonetes Energéticos"
          description="Limpeza física e vibracional."
          price=""
          image={sabonetesImage}
          desktopOnly={true}
        />

        <!-- Sabonetes (Mobile Only) -->
        <ProductCard 
          title="Sabonetes Energéticos"
          description="Feitos à mão com óleos essenciais para limpeza áurica."
          price="CHF 25"
          image={sabonetesImage}
          badge="Limpeza"
          badgeBg="bg-tertiary-fixed/40"
          mobileOnly={true}
        />
        
        <!-- Banhos de Ervas (Desktop Only) -->
        <ProductCard 
          title="Banhos de Ervas"
          description="Misturas ancestrais para infusão."
          image={banhosImage}
          delayClass="md:translate-y-12"
          desktopOnly={true}
        />

        <!-- Óleos Essenciais (Mobile Only) -->
        <ProductCard 
          title="Óleos Essenciais"
          description="Blends exclusivos para meditação e foco."
          price="CHF 40"
          badge="Foco"
          badgeBg="bg-secondary-fixed/40"
          isPlaceholder={true}
          delayClass="delay-100"
          mobileOnly={true}
        />

        <!-- Kits de Ritual (Desktop Only) -->
        <ProductCard 
          title="Kits de Ritual"
          description="Experiências completas de cura."
          image={kitsImage}
          delayClass="delay-200"
          desktopOnly={true}
        />

        <!-- E-books & Guias (Desktop Only) -->
        <ProductCard 
          title="E-books & Guias"
          description="Conhecimento para sua jornada."
          image={ebooksImage}
          delayClass="delay-300 md:translate-y-12"
          desktopOnly={true}
        />
      </div>

      <div class="mt-8 text-center md:hidden">
        <a href="#" class="text-primary font-label-md text-label-md border-b border-primary pb-1 hover:text-secondary hover:border-secondary transition-colors">
          Ver Boutique Completa
        </a>
      </div>
    </section>


    <!-- SERVICES / THERAPIES SECTION -->
    <section id="terapias" class="py-section-gap-lg px-margin-mobile md:px-gutter max-w-container-max mx-auto bg-surface">
      <div class="grid md:grid-cols-12 gap-12 md:gap-16">
        <div class="md:col-span-4 reveal-element">
          <span class="font-label-md text-label-md text-secondary uppercase tracking-[0.2em] mb-4 block">Experiências</span>
          <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-6 md:mb-8 leading-tight">Terapias que elevam a alma</h2>
          <p class="text-on-surface-variant mb-8 md:mb-10 hidden md:block">Sessões individuais focadas no equilíbrio energético e autoconhecimento profundo.</p>
          <p class="text-on-surface-variant mb-8 md:mb-10 md:hidden">Práticas ancestrais para o homem moderno.</p>
          <a href="#agendamento" class="inline-block bg-primary text-on-primary px-8 py-4 rounded-full font-label-md text-label-md hover:bg-primary/90 active:scale-95 transition-all duration-200 text-center">
            Agendar Consultoria
          </a>
        </div>
        
        <div class="md:col-span-7 md:col-start-6">
          <!-- Desktop Layout list -->
          <div class="hidden md:block space-y-4">
            <ServiceItem 
              num="01"
              title="Reiki Usui"
              description="Harmonização dos chakras e redução profunda do estresse através da imposição de mãos."
              badge="Energia"
              delayClass="delay-100"
              desktopOnly={true}
            />
            <ServiceItem 
              num="02"
              title="Aromaterapia Vibracional"
              description="Uso terapêutico de óleos essenciais para tratar questões emocionais e físicas."
              badge="Botânica"
              delayClass="delay-200"
              desktopOnly={true}
            />
            <ServiceItem 
              num="03"
              title="Leitura de Cabala"
              description="Um mapa para entender sua missão de alma e os desafios de crescimento pessoal."
              badge="Sabedoria"
              delayClass="delay-300"
              desktopOnly={true}
            />
          </div>

          <!-- Mobile Layout cards -->
          <div class="md:hidden flex flex-col gap-4">
            <ServiceItem 
              num="01"
              title="Reiki Usui"
              description="Realinhamento energético através da imposição de mãos. Promove calma profunda e clareza mental."
              duration="60 min"
              price="CHF 120"
              bgGradClass="bg-primary-fixed/20"
              delayClass="delay-100"
              mobileOnly={true}
            />
            <ServiceItem 
              num="02"
              title="Aromaterapia Clássica"
              description="Uso terapêutico de óleos essenciais puros para equilibrar emoções e restaurar o vigor físico."
              duration="45 min"
              price="CHF 95"
              bgGradClass="bg-secondary-fixed/20"
              delayClass="delay-200"
              mobileOnly={true}
            />
          </div>
        </div>
      </div>
    </section>


    <!-- FOUNDER STORY (Desktop Only per mobile specs) -->
    <section id="sobre" class="hidden md:block py-section-gap-lg px-gutter bg-surface-container-low overflow-hidden">
      <div class="max-w-container-max mx-auto grid md:grid-cols-2 gap-20 items-center">
        <div class="relative reveal-element">
          <div class="aspect-[3/4] rounded-[60px] overflow-hidden border border-outline-variant/20 shadow-2xl">
            <Image alt="Daiane - Licht der Seele" class="w-full h-full object-cover grayscale-[0.3]" src={founderImage} />
          </div>
          <div class="absolute -top-6 -right-6 p-8 bg-surface rounded-3xl border border-outline-variant/20 max-w-[200px]">
            <p class="font-label-md text-xs text-primary leading-relaxed">Fundado em Zurique por Daiane, uma jornada de volta à essência.</p>
          </div>
        </div>
        <div class="max-w-md reveal-element delay-100">
          <span class="font-label-md text-label-md text-secondary uppercase tracking-[0.2em] mb-4 block">A Alma por trás</span>
          <h2 class="font-headline-lg text-headline-lg text-primary mb-8">Nossa Missão em Zurique</h2>
          <p class="text-on-surface-variant mb-6 leading-relaxed">
            Licht der Seele nasceu do desejo de criar uma ponte entre a espiritualidade ancestral e a vida contemporânea acelerada. 
          </p>
          <p class="text-on-surface-variant mb-10 leading-relaxed">
            Em nosso refúgio em Zurique, selecionamos cada erva, cada óleo e cada técnica para garantir que sua jornada de cura seja tão luxuosa quanto eficaz. Não buscamos curas rápidas, mas transformações sustentáveis.
          </p>
          <a class="inline-flex items-center gap-4 font-label-md text-primary group nav-link-underline pb-1" href="#">
            Conheça minha história 
            <span class="material-symbols-outlined group-hover:translate-x-2 transition-transform" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>


    <!-- HOW IT WORKS (Desktop Only per mobile specs) -->
    <section class="hidden md:block py-section-gap-lg bg-breathe">
      <div class="px-gutter max-w-container-max mx-auto">
        <div class="text-center mb-20 reveal-element">
          <h2 class="font-headline-lg text-headline-lg text-primary mb-4">Sua Jornada de Cuidado</h2>
          <p class="text-on-surface-variant">Simplicidade e intenção em cada passo.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-12 text-center">
          <div class="p-8 reveal-element delay-100">
            <div class="w-16 h-16 bg-surface-container-high rounded-full flex items-center justify-center mx-auto mb-8 text-primary transition-transform duration-300 hover:scale-110 cursor-default">
              <span class="material-symbols-outlined text-3xl" aria-hidden="true">calendar_today</span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-primary mb-4">Agende seu tempo</h3>
            <p class="text-on-surface-variant text-sm">Escolha a terapia que mais ressoa com seu momento atual através do nosso sistema online.</p>
          </div>
          <div class="p-8 md:border-x border-outline-variant/10 reveal-element delay-200">
            <div class="w-16 h-16 bg-surface-container-high rounded-full flex items-center justify-center mx-auto mb-8 text-primary transition-transform duration-300 hover:scale-110 cursor-default">
              <span class="material-symbols-outlined text-3xl" aria-hidden="true">self_care</span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-primary mb-4">Receba o Cuidado</h3>
            <p class="text-on-surface-variant text-sm">Uma sessão personalizada, seja presencial ou online, focada inteiramente na sua energia.</p>
          </div>
          <div class="p-8 reveal-element delay-300">
            <div class="w-16 h-16 bg-surface-container-high rounded-full flex items-center justify-center mx-auto mb-8 text-primary transition-transform duration-300 hover:scale-110 cursor-default">
              <span class="material-symbols-outlined text-3xl" aria-hidden="true">auto_fix_high</span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-primary mb-4">Ritualize em casa</h3>
            <p class="text-on-surface-variant text-sm">Mantenha a vibração com nossos produtos exclusivos e orientações pós-sessão.</p>
          </div>
        </div>
      </div>
    </section>


    <!-- TESTIMONIALS (Desktop Only per mobile specs) -->
    <section class="hidden md:block py-section-gap-lg px-gutter bg-surface-bright">
      <div class="max-w-container-max mx-auto">
        <div class="grid md:grid-cols-3 gap-12">
          <div class="reveal-element delay-100 flex flex-col justify-between p-10 bg-white rounded-3xl border border-outline-variant/10 shadow-sm hover:shadow-md transition-shadow duration-300">
            <p class="font-body-lg text-primary italic mb-10">"A sessão de Reiki com a Daiane mudou minha perspectiva sobre o estresse diário. Sinto-me renovada e com muito mais clareza."</p>
            <span class="font-label-md text-secondary">— Helena M., Designer</span>
          </div>
          <div class="reveal-element delay-200 flex flex-col justify-between p-10 bg-white rounded-3xl border border-outline-variant/10 shadow-sm hover:shadow-md transition-shadow duration-300 md:-translate-y-8">
            <p class="font-body-lg text-primary italic mb-10">"Os sabonetes energéticos são um ritual sagrado para mim agora. A qualidade das ervas é visível em cada detalhe."</p>
            <span class="font-label-md text-secondary">— Beatriz S., Terapeuta</span>
          </div>
          <div class="reveal-element delay-300 flex flex-col justify-between p-10 bg-white rounded-3xl border border-outline-variant/10 shadow-sm hover:shadow-md transition-shadow duration-300">
            <p class="font-body-lg text-primary italic mb-10">"A leitura de Cabala foi um divisor de águas. Consegui entender padrões que me travavam há anos."</p>
            <span class="font-label-md text-secondary">— Ricardo F., Arquiteto</span>
          </div>
        </div>
      </div>
    </section>


    <!-- FINAL CTA SECTION -->
    <div id="agendamento">
      <!-- Desktop CTA -->
      <section class="hidden md:block py-section-gap-lg px-gutter text-center relative overflow-hidden reveal-element">
        <div class="absolute inset-0 bg-primary/5 -z-10"></div>
        <div class="max-w-2xl mx-auto">
          <h2 class="font-display-lg text-display-lg text-primary mb-10">Inicie sua jornada de clareza</h2>
          <p class="text-on-surface-variant mb-12 text-lg">Estamos prontos para acolher você e sua energia. Reserve seu espaço de cura hoje mesmo.</p>
          <a href="mailto:fragrancetofaith@gmail.com?subject=Agendamento%20Licht%20der%20Seele" class="inline-block bg-primary text-on-primary px-12 py-6 rounded-full font-label-md text-label-md hover:bg-primary/90 active:scale-95 transition-all duration-200 shadow-xl">
            Agendar Agora
          </a>
        </div>
      </section>

      <!-- Mobile CTA -->
      <section class="md:hidden py-section-gap-md px-margin-mobile bg-primary text-surface text-center rounded-t-[40px] mt-8 relative overflow-hidden">
        <div class="absolute inset-0 opacity-20 pointer-events-none bg-[radial-gradient(circle_at_top,var(--color-primary-fixed)_0%,transparent_60%)]"></div>
        <div class="relative z-10 max-w-md mx-auto">
          <span class="material-symbols-outlined text-4xl mb-4 text-primary-fixed-dim" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">self_care</span>
          <h2 class="font-headline-md text-headline-md mb-4 text-surface">Inicie sua jornada de clareza</h2>
          <p class="font-body-md text-body-md text-surface-variant/80 mb-8">Permita-se um momento de pausa autêntica no coração de Zurique.</p>
          <a href="mailto:fragrancetofaith@gmail.com?subject=Agendamento%20Licht%20der%20Seele" class="inline-block bg-surface text-primary font-label-md text-label-md px-8 py-4 rounded-full hover:bg-surface-variant transition-all duration-300 w-full sm:w-auto shadow-lg text-center">
            Agendar Agora
          </a>
        </div>
      </section>
    </div>
  </main>

  <!-- Desktop Footer -->
  <Footer />

  <!-- Mobile Floating Navigation Bar -->
  <BottomNav />
</Layout>
